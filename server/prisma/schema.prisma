generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER MANAGEMENT
// ==========================================

enum UserRole {
  MEMBER
  INSTRUCTOR
  MANAGER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  taughtClasses DanceClass[]  @relation("ClassInstructor")
  weeklyClasses WeeklyClass[] @relation("WeeklyClassInstructor")
  bookings      Booking[]

  // Cancellation management
  studioCancellations StudioCancellation[] @relation("StudioCancelledBy")
  classCancellations  ClassCancellation[]  @relation("ClassCancelledBy")

  studioRestorations StudioCancellation[] @relation("StudioRestoredBy")
  classRestorations  ClassCancellation[]  @relation("ClassRestoredBy")

  // Studio rental management
  studioRentals   StudioRental[]  @relation("RentalCustomer")
  approvedRentals StudioRental[]  @relation("RentalApprover")
  rentalPayments  RentalPayment[] @relation("RentalPaymentRecorder")

  @@index([role])
}

// ==========================================
// AUTHENTICATION AND SESSIONS
// ==========================================

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// CLASS ENUMS
// ==========================================

enum ClassLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  OPEN_LEVEL
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WeeklyBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  NO_SHOW
}

// ==========================================
// INDIVIDUAL DANCE CLASSES
// ==========================================

model DanceClass {
  id          String     @id @default(uuid())
  title       String
  description String?
  level       ClassLevel @default(BEGINNER)

  startsAt DateTime
  endsAt   DateTime

  capacity   Int @default(20)
  priceCents Int @default(1500)

  isActive Boolean @default(true)

  instructorId String
  instructor   User   @relation("ClassInstructor", fields: [instructorId], references: [id])

  // Room assignment
  roomId String?
  room   StudioRoom? @relation(fields: [roomId], references: [id], onDelete: Restrict)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
  @@index([startsAt])
  @@index([roomId, startsAt])
}

// ==========================================
// MEMBER BOOKINGS
// ==========================================

model Booking {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  danceClassId String
  danceClass   DanceClass @relation(fields: [danceClassId], references: [id])

  status BookingStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, danceClassId])
  @@index([danceClassId, status])
}

// ==========================================
// RECURRING WEEKLY CLASSES
// ==========================================

model WeeklyClass {
  id          String     @id @default(uuid())
  title       String
  description String?
  level       ClassLevel @default(BEGINNER)

  dayOfWeek        DayOfWeek
  startTimeMinutes Int
  durationMinutes  Int

  capacity   Int @default(20)
  priceCents Int @default(1500)

  isActive Boolean @default(true)

  instructorId String
  instructor   User   @relation("WeeklyClassInstructor", fields: [instructorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Room assignment
  roomId String?
  room   StudioRoom? @relation(fields: [roomId], references: [id], onDelete: Restrict)

  bookings      WeeklyClassBooking[]
  cancellations ClassCancellation[]

  @@index([dayOfWeek, startTimeMinutes])
  @@index([roomId, dayOfWeek, startTimeMinutes])
  @@index([instructorId])
}

// ==========================================
// PUBLIC WEEKLY CLASS BOOKINGS
// ==========================================

model WeeklyClassBooking {
  id String @id @default(uuid())

  bookingReference String

  // Guest information
  guestFirstName String
  guestLastName  String
  guestEmail     String
  guestPhone     String

  // Weekly class relationship
  weeklyClassId String
  weeklyClass   WeeklyClass @relation(fields: [weeklyClassId], references: [id], onDelete: Restrict)

  // Actual class date
  classDate DateTime @db.Date

  status WeeklyBookingStatus @default(PENDING)

  // Payment
  priceCents Int
  paidAt     DateTime?

  marketingConsent Boolean @default(false)

  notes String?

  // Attendance management
  attendanceStatus     AttendanceStatus?
  attendanceMarkedAt   DateTime?
  attendanceMarkedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weeklyClassId, classDate, status])
  @@index([guestEmail])
  @@index([bookingReference])
  @@index([attendanceStatus])
}

// ==========================================
// STUDIO-WIDE CLASS CANCELLATIONS
// ==========================================

model StudioCancellation {
  id String @id @default(uuid())

  // Cancel all recurring classes on this date
  classDate DateTime @unique @db.Date

  reason String

  // Optional message displayed to customers
  publicMessage String?

  // False means the cancellation was restored
  isActive Boolean @default(true)

  // Staff member responsible for cancellation
  cancelledById String
  cancelledBy   User   @relation("StudioCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  cancelledAt DateTime @default(now())

  // Restoration information
  restoredById String?
  restoredBy   User?   @relation("StudioRestoredBy", fields: [restoredById], references: [id], onDelete: Restrict)

  restoredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, classDate])
  @@index([cancelledById])
}

// ==========================================
// INDIVIDUAL CLASS CANCELLATIONS
// ==========================================

model ClassCancellation {
  id String @id @default(uuid())

  // The recurring class being cancelled
  weeklyClassId String
  weeklyClass   WeeklyClass @relation(fields: [weeklyClassId], references: [id], onDelete: Restrict)

  // Cancel only this specific occurrence
  classDate DateTime @db.Date

  reason String

  // Optional message displayed to customers
  publicMessage String?

  isActive Boolean @default(true)

  // Staff member responsible for cancellation
  cancelledById String
  cancelledBy   User   @relation("ClassCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  cancelledAt DateTime @default(now())

  // Restoration information
  restoredById String?
  restoredBy   User?   @relation("ClassRestoredBy", fields: [restoredById], references: [id], onDelete: Restrict)

  restoredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate cancellations
  @@unique([weeklyClassId, classDate])
  @@index([classDate, isActive])
  @@index([cancelledById])
}

enum RentalStatus {
  PENDING
  APPROVED
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum RentalPaymentType {
  DEPOSIT
  BALANCE
  FULL_PAYMENT
  REFUND
}

enum RentalPaymentMethod {
  CASH
  ZELLE
  CARD
  BANK_TRANSFER
  OTHER
}

model StudioRoom {
  id             String               @id @default(uuid())
  name           String               @unique
  description    String?
  capacity       Int?
  areaSquareFeet Int?
  amenities      String[]             @default([])
  photoUrls      String[]             @default([])
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  weeklyClasses  WeeklyClass[]
  danceClasses   DanceClass[]
  rates          RentalRate[]
  rentals        RentalRoom[]
  blocks         RoomBlock[]
  operatingHours RoomOperatingHours[]
}

model RentalCategory {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  rates       RentalRate[]
  rentals     StudioRental[]
}

model RentalRate {
  id                      String         @id @default(uuid())
  roomId                  String
  room                    StudioRoom     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  categoryId              String
  category                RentalCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  hourlyRateCents         Int
  minimumMinutes          Int            @default(60)
  billingIncrementMinutes Int            @default(60)
  depositBasisPoints      Int            @default(5000)
  depositRefundable       Boolean        @default(false)
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@unique([roomId, categoryId])
}

model StudioRental {
  id                   String          @id @default(uuid())
  reference            String          @unique @default(uuid())
  customerId           String?
  customer             User?           @relation("RentalCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  contactName          String
  contactEmail         String
  contactPhone         String
  categoryId           String
  category             RentalCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  startsAt             DateTime        @db.Timestamptz(3)
  endsAt               DateTime        @db.Timestamptz(3)
  status               RentalStatus    @default(PENDING)
  guestCount           Int?
  notes                String?
  totalCents           Int
  cleaningFeeCents     Int             @default(0)
  depositRequiredCents Int
  depositRefundable    Boolean         @default(false)
  agreementVersion     String?
  agreementAcceptedAt  DateTime?
  approvedById         String?
  approvedBy           User?           @relation("RentalApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt           DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  seriesId             String?
  series               RentalSeries?   @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  rooms                RentalRoom[]
  payments             RentalPayment[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([customerId])
  @@index([seriesId])
}

model RentalRoom {
  rentalId        String
  rental          StudioRental @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  roomId          String
  room            StudioRoom   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  hourlyRateCents Int
  billedMinutes   Int
  subtotalCents   Int

  @@id([rentalId, roomId])
  @@index([roomId])
}

model RentalPayment {
  id           String              @id @default(uuid())
  rentalId     String
  rental       StudioRental        @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  type         RentalPaymentType
  method       RentalPaymentMethod
  amountCents  Int
  reference    String?
  paidAt       DateTime            @default(now())
  recordedById String?
  recordedBy   User?               @relation("RentalPaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())

  @@index([rentalId, paidAt])
}

// Groups individual dated reservations into a recurring arrangement.
model RentalSeries {
  id        String         @id @default(uuid())
  name      String
  notes     String?
  isActive  Boolean        @default(true)
  rentals   StudioRental[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model RoomBlock {
  id        String     @id @default(uuid())
  roomId    String
  room      StudioRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startsAt  DateTime   @db.Timestamptz(3)
  endsAt    DateTime   @db.Timestamptz(3)
  reason    String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([roomId, isActive, startsAt, endsAt])
}

model RoomOperatingHours {
  id              String     @id @default(uuid())
  roomId          String
  room            StudioRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  dayOfWeek       DayOfWeek
  opensAtMinutes  Int
  closesAtMinutes Int

  @@unique([roomId, dayOfWeek, opensAtMinutes])
}

// ==========================================
// STUDIO RENTAL PRICING
// ==========================================

enum RentalPricingScope {
  SINGLE_ROOM
  ENTIRE_STUDIO
  LARGE_GROUP
}

enum RentalDayType {
  EVERY_DAY
  WEEKDAY
  WEEKEND
}

model RentalPricingRule {
  id String @id @default(uuid())

  name        String
  description String?

  scope   RentalPricingScope
  dayType RentalDayType      @default(EVERY_DAY)

  // Time configuration
  startTimeMinutes Int @default(0)
  endTimeMinutes   Int @default(1440)

  // Pricing configuration
  hourlyRateCents Int?
  requiresQuote   Boolean @default(false)

  // Additional fees
  cleaningFeeCents Int @default(0)

  // Rental policies
  minimumMinutes          Int     @default(60)
  billingIncrementMinutes Int     @default(60)
  depositBasisPoints      Int     @default(5000)
  depositRefundable       Boolean @default(false)

  // Large group configuration
  minimumGuestCount Int?

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, dayType, startTimeMinutes, endTimeMinutes])
  @@index([scope, dayType, isActive])
}
