generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  INSTRUCTOR
  MANAGER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  taughtClasses DanceClass[] @relation("ClassInstructor")
  bookings      Booking[]

  @@index([role])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ClassLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  OPEN_LEVEL
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model DanceClass {
  id          String     @id @default(uuid())
  title       String
  description String?
  level       ClassLevel @default(BEGINNER)

  // Date and time for this class session
  startsAt DateTime
  endsAt   DateTime

  // Class capacity and price in cents
  capacity   Int @default(20)
  priceCents Int @default(1500)

  isActive Boolean @default(true)

  // Instructor relationship
  instructorId String
  instructor   User   @relation("ClassInstructor", fields: [instructorId], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
  @@index([startsAt])
}

model Booking {
  id String @id @default(uuid())

  // Dancer relationship
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Class relationship
  danceClassId String
  danceClass   DanceClass @relation(fields: [danceClassId], references: [id])

  status BookingStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate reservations
  @@unique([userId, danceClassId])
  @@index([danceClassId, status])
}
