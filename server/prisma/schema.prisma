generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER MANAGEMENT
// ==========================================

enum UserRole {
  MEMBER
  INSTRUCTOR
  MANAGER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  taughtClasses DanceClass[]  @relation("ClassInstructor")
  weeklyClasses WeeklyClass[] @relation("WeeklyClassInstructor")
  bookings      Booking[]

  // Cancellation management
  studioCancellations StudioCancellation[] @relation("StudioCancelledBy")
  classCancellations  ClassCancellation[]  @relation("ClassCancelledBy")

  studioRestorations StudioCancellation[] @relation("StudioRestoredBy")
  classRestorations  ClassCancellation[]  @relation("ClassRestoredBy")

  @@index([role])
}

// ==========================================
// AUTHENTICATION AND SESSIONS
// ==========================================

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// CLASS ENUMS
// ==========================================

enum ClassLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  OPEN_LEVEL
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WeeklyBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  NO_SHOW
}

// ==========================================
// INDIVIDUAL DANCE CLASSES
// ==========================================

model DanceClass {
  id          String     @id @default(uuid())
  title       String
  description String?
  level       ClassLevel @default(BEGINNER)

  startsAt DateTime
  endsAt   DateTime

  capacity   Int @default(20)
  priceCents Int @default(1500)

  isActive Boolean @default(true)

  instructorId String
  instructor   User   @relation("ClassInstructor", fields: [instructorId], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
  @@index([startsAt])
}

// ==========================================
// MEMBER BOOKINGS
// ==========================================

model Booking {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  danceClassId String
  danceClass   DanceClass @relation(fields: [danceClassId], references: [id])

  status BookingStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, danceClassId])
  @@index([danceClassId, status])
}

// ==========================================
// RECURRING WEEKLY CLASSES
// ==========================================

model WeeklyClass {
  id          String     @id @default(uuid())
  title       String
  description String?
  level       ClassLevel @default(BEGINNER)

  dayOfWeek        DayOfWeek
  startTimeMinutes Int
  durationMinutes  Int

  capacity   Int @default(20)
  priceCents Int @default(1500)

  isActive Boolean @default(true)

  instructorId String
  instructor   User   @relation("WeeklyClassInstructor", fields: [instructorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings      WeeklyClassBooking[]
  cancellations ClassCancellation[]

  @@index([dayOfWeek, startTimeMinutes])
  @@index([instructorId])
}

// ==========================================
// PUBLIC WEEKLY CLASS BOOKINGS
// ==========================================

model WeeklyClassBooking {
  id String @id @default(uuid())

  bookingReference String

  // Guest information
  guestFirstName String
  guestLastName  String
  guestEmail     String
  guestPhone     String

  // Weekly class relationship
  weeklyClassId String
  weeklyClass   WeeklyClass @relation(fields: [weeklyClassId], references: [id], onDelete: Restrict)

  // Actual class date
  classDate DateTime @db.Date

  status WeeklyBookingStatus @default(PENDING)

  // Payment
  priceCents Int
  paidAt     DateTime?

  marketingConsent Boolean @default(false)

  notes String?

  // Attendance management
  attendanceStatus     AttendanceStatus?
  attendanceMarkedAt   DateTime?
  attendanceMarkedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weeklyClassId, classDate, status])
  @@index([guestEmail])
  @@index([bookingReference])
  @@index([attendanceStatus])
}

// ==========================================
// STUDIO-WIDE CLASS CANCELLATIONS
// ==========================================

model StudioCancellation {
  id String @id @default(uuid())

  // Cancel all recurring classes on this date
  classDate DateTime @unique @db.Date

  reason String

  // Optional message displayed to customers
  publicMessage String?

  // False means the cancellation was restored
  isActive Boolean @default(true)

  // Staff member responsible for cancellation
  cancelledById String
  cancelledBy   User   @relation("StudioCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  cancelledAt DateTime @default(now())

  // Restoration information
  restoredById String?
  restoredBy   User?   @relation("StudioRestoredBy", fields: [restoredById], references: [id], onDelete: Restrict)

  restoredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, classDate])
  @@index([cancelledById])
}

// ==========================================
// INDIVIDUAL CLASS CANCELLATIONS
// ==========================================

model ClassCancellation {
  id String @id @default(uuid())

  // The recurring class being cancelled
  weeklyClassId String
  weeklyClass   WeeklyClass @relation(fields: [weeklyClassId], references: [id], onDelete: Restrict)

  // Cancel only this specific occurrence
  classDate DateTime @db.Date

  reason String

  // Optional message displayed to customers
  publicMessage String?

  isActive Boolean @default(true)

  // Staff member responsible for cancellation
  cancelledById String
  cancelledBy   User   @relation("ClassCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  cancelledAt DateTime @default(now())

  // Restoration information
  restoredById String?
  restoredBy   User?   @relation("ClassRestoredBy", fields: [restoredById], references: [id], onDelete: Restrict)

  restoredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate cancellations
  @@unique([weeklyClassId, classDate])
  @@index([classDate, isActive])
  @@index([cancelledById])
}
